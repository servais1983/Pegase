# Copy to .env and adjust before `docker compose up`.
PEGASE_ENVIRONMENT=production
PEGASE_SECRET_KEY=replace-me-with-a-strong-random-string
PEGASE_DB_PASSWORD=replace-me
PEGASE_LOG_LEVEL=INFO

# --- AI layer ---------------------------------------------------------------
# Default is fully offline & deterministic (no API key, nothing leaves the host).
# Set a provider + key to enable LLM-augmented narratives and the jury.
PEGASE_AI_PROVIDER=offline           # offline | anthropic | openai | ollama
PEGASE_AI_MODEL=                     # e.g. claude-sonnet-4-5, gpt-4o-mini, llama3
PEGASE_AI_API_KEY=                   # required for cloud providers
PEGASE_AI_BASE_URL=                  # override for self-hosted / gateway / ollama
PEGASE_AI_JURY_ENABLED=false         # multi-model finding validation
